{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dbinit",
  "version": "1.0.0",
  "identifier": "dev.jotave.dbinit",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DBInit",
        "width": 500,
        "height": 500,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
