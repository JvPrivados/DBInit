{
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite",
    "build": "deno run -A --node-modules-dir=auto npm:vite build",
    "tauri": "deno run -A npm:@tauri-apps/cli",
    "run": "deno task tauri dev"
  },
  "imports": {
    "vue": "npm:vue@latest",
    "vite": "npm:vite@latest",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@latest",
    "tailwindcss": "npm:tailwindcss@latest",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@latest",
    "@tauri-apps/api": "npm:@tauri-apps/api@^2.0.0"
  }
}
